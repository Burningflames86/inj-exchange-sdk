{
  "name": "inj-trading-sdk",
  "version": "0.1.0",
  "description": "Trading messages, query clients and EIP-712 transaction building for the Injective exchange module",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./clients/*": {
      "types": "./dist/clients/*.d.ts",
      "default": "./dist/clients/*.js"
    },
    "./msgs/*": {
      "types": "./dist/msgs/*.d.ts",
      "default": "./dist/msgs/*.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt clients managers msgs scripts types utils",
    "format:check": "oxfmt --check clients managers msgs scripts types utils",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun run scripts/add-js-extensions.ts",
    "prepublishOnly": "bun run check && bun run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@grpc/grpc-js": "^1.14.4",
    "@scure/base": "^2.3.0",
    "eventemitter3": "^5.0.4",
    "viem": "^2.58.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "ts-proto": "^2.12.0",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
