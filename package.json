{
  "name": "inj-trading-sdk",
  "version": "0.1.0",
  "description": "Trading messages, query clients and EIP-712 transaction building for the Injective exchange module",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./clients/*": "./clients/*.ts",
    "./msgs/*": "./msgs/*.ts",
    "./types/*": "./types/*.ts",
    "./utils/*": "./utils/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "clients",
    "gen",
    "managers",
    "msgs",
    "types",
    "utils"
  ],
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt clients managers msgs types utils",
    "format:check": "oxfmt --check clients managers msgs types utils",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run format:check && bun run typecheck"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@grpc/grpc-js": "^1.14.4",
    "@scure/base": "^2.3.0",
    "eventemitter3": "^5.0.4",
    "viem": "^2.58.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "ts-proto": "^2.12.0",
    "typescript": "^7.0.2"
  },
  "main": "./index.ts",
  "types": "./index.ts"
}
