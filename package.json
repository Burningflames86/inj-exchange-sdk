{
  "name": "@burningflames/inj-exchange-sdk",
  "version": "0.1.1",
  "description": "Trading messages, query clients and EIP-712 transaction building for the Injective exchange module",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./clients/chain": {
      "import": {
        "types": "./dist/clients/chain.d.ts",
        "default": "./dist/clients/chain.js"
      },
      "require": {
        "types": "./dist/clients/chain.d.cts",
        "default": "./dist/clients/chain.cjs"
      }
    },
    "./clients/indexer": {
      "import": {
        "types": "./dist/clients/indexer.d.ts",
        "default": "./dist/clients/indexer.js"
      },
      "require": {
        "types": "./dist/clients/indexer.d.cts",
        "default": "./dist/clients/indexer.cjs"
      }
    },
    "./msgs": {
      "import": {
        "types": "./dist/msgs.d.ts",
        "default": "./dist/msgs.js"
      },
      "require": {
        "types": "./dist/msgs.d.cts",
        "default": "./dist/msgs.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt clients managers msgs tests types utils tsdown.config.ts",
    "format:check": "oxfmt --check clients managers msgs tests types utils tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun test",
    "build": "tsdown",
    "prepublishOnly": "bun run check && bun run check:pack",
    "prepack": "bun run build",
    "test": "bun test",
    "record:fixtures": "bun run scripts/record-encoding-fixtures.ts",
    "check:pack": "bun run scripts/check-pack.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@grpc/grpc-js": "^1.14.4",
    "@scure/base": "^2.3.0",
    "eventemitter3": "^5.0.4",
    "viem": "^2.58.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "ts-proto": "^2.12.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Burningflames86/inj-exchange-sdk.git"
  },
  "homepage": "https://github.com/Burningflames86/inj-exchange-sdk#readme",
  "bugs": {
    "url": "https://github.com/Burningflames86/inj-exchange-sdk/issues"
  },
  "keywords": [
    "injective",
    "grpc",
    "trading",
    "exchange",
    "perpetuals",
    "eip712",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  }
}
